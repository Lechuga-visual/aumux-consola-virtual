#include <windows.h>

1 ICON "__ICON_PATH__"

1 VERSIONINFO
FILEVERSION __VERSION_MAJOR__,__VERSION_MINOR__,__VERSION_PATCH__,0
PRODUCTVERSION __VERSION_MAJOR__,__VERSION_MINOR__,__VERSION_PATCH__,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "AuMux audio mixer\0"
            VALUE "FileVersion", "__VERSION__\0"
            VALUE "InternalName", "AuMux\0"
            VALUE "OriginalFilename", "AuMux.exe\0"
            VALUE "ProductName", "AuMux\0"
            VALUE "ProductVersion", "__VERSION__\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
